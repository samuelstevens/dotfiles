{
  "global": {
    "cmd-q": "app.quit",
    "cmd-h": "app.hide",
    "cmd-alt-h": "app.hide_others",
    "cmd-=": "app.zoom_in",
    "cmd-+": "app.zoom_in",
    "cmd--": "app.zoom_out",
    "cmd-0": "app.zoom_reset",
    "ctrl-a |": "pane.split:right",
    "ctrl-a _": "pane.split:down",
    "ctrl-a -": "pane.split:down",
    "ctrl-a (": "space.prev",
    "ctrl-a )": "space.next",
    "ctrl-a h": "pane.go:left",
    "ctrl-a j": "pane.go:down",
    "ctrl-a k": "pane.go:up",
    "ctrl-a l": "pane.go:right",
    "ctrl-a ?": "app.help",
    "ctrl-a s": "app.settings",
    "ctrl-a w": "mod.open:picker",
    "ctrl-a shift-n": "space.new",
    "ctrl-a shift-w": "space.rename",
    "ctrl-a shift-d": "space.close",
    "ctrl-a c": "tab.new",
    "ctrl-a shift-t": "tab.rename",
    "ctrl-a p": "tab.prev",
    "ctrl-a n": "tab.next",
    "ctrl-a shift-x": "tab.close",
    "ctrl-a x": "pane.close",
    "ctrl-a z": "pane.zoom",
    "ctrl-a b": "layout.toggle:sidebar",
    "ctrl-a 1": "tab.select:1",
    "ctrl-a 2": "tab.select:2",
    "ctrl-a 3": "tab.select:3",
    "ctrl-a 4": "tab.select:4",
    "ctrl-a 5": "tab.select:5",
    "ctrl-a 6": "tab.select:6",
    "ctrl-a 7": "tab.select:7",
    "ctrl-a 8": "tab.select:8",
    "ctrl-a 9": "tab.select:9",
    "cmd-k": "app.palette"
  },
  "terminal": {
    "cmd-c": "terminal.copy",
    "cmd-v": "terminal.paste",
    "ctrl-v": "terminal.paste_image",
    "alt-left": "send:\u001bb",
    "alt-right": "send:\u001bf",
    "alt-backspace": "send:\u0017",
    "cmd-left": "send:\u0001",
    "cmd-right": "send:\u0005",
    "cmd-backspace": "send:\u0015",
    "ctrl-a ctrl-a": "send:\u0001",
    "cmd-enter": "send:\u001b\r"
  }
}
